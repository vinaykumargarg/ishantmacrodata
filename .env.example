# =============================================================================
# ISHANT MACRO AI TERMINAL (NEXVORA AI) — PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# “See the Flow. Read the Market. Trade with Clarity.”
# =============================================================================

# 1. Supabase Project Configuration (Auth, Database, Entitlements)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Razorpay Payment Gateway (Indian Rupee INR Subscription Checkout)
# Found in: Razorpay Dashboard -> Settings -> API Keys
# Test Key format: rzp_test_... | Production Key format: rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# 3. Google OAuth 2.0 (Configured inside Supabase Auth -> Providers -> Google)
# Found in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI in Google Cloud:
# https://<your-project-ref>.supabase.co/auth/v1/callback

# 4. Phone SMS Gateway (Configured inside Supabase Auth -> Providers -> Phone)
# Supports: Twilio (Account SID, Auth Token, Message Service SID) for India (+91) OTP

# 5. Telegram Official Bot API Integration (Server-side Only)
# Bot Token from @BotFather (Never expose on frontend)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_SERVER_PORT=5055

# 6. Production Domain:
# Custom Domain: https://ishantmacro.ai or Vercel URL https://ishantmacrodata.vercel.app
